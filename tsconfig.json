{
  "compilerOptions": {
    "target": "ES2017",
    "lib": [
      "dom",
      "dom.iterable",
      "esnext"
    ],
    "allowJs": true,
    "skipLibCheck": true,
    "strict": true,
    "noEmit": true,
    "esModuleInterop": true,
    "module": "esnext",
    "moduleResolution": "bundler",
    "resolveJsonModule": true,
    "isolatedModules": true,
    "jsx": "react-jsx",
    "incremental": true,
    "plugins": [
      {
        "name": "next"
      }
    ],
    "paths": {
      "@/*": [
        "./*"
      ]
    }
  },
  "include": [
    "next-env.d.ts",
    "**/*.ts",
    "**/*.tsx",
    "**/*.mts",
    ".next/types/**/*.ts",
    ".next/dev/types/**/*.ts"
  ],
  // Quarantined: lib/crypto-engine is an asset-scoring subsystem that has
  // never compiled (it imports a `ModuleResult` type that is defined nowhere)
  // and that emits bullish/bearish signals, which Vision.md rules out as a
  // closed design decision. Excluded so the rest of the project typechecks;
  // the code is kept for a later keep-or-delete call, and nothing reachable
  // calls it. Delete these entries — or the directories — when that is decided.
  "exclude": [
    "node_modules",
    "lib/crypto-engine",
    "app/api/_quarantined"
  ]
}
